# Reference file only: the app reads environment variables directly.
TELEGRAM_BOT_TOKEN=replace-with-your-telegram-bot-token
ALLOWED_USER_IDS=replace-with-your-numeric-telegram-id

# Stage 2 news settings (optional; defaults shown).
NEWS_DB_PATH=data/cyberpath.sqlite3
NEWS_LOOKBACK_HOURS=72
NEWS_CACHE_MINUTES=30
NEWS_REFRESH_COOLDOWN_SECONDS=60
NEWS_HTTP_TIMEOUT_SECONDS=12
NEWS_NVD_MAX_PAGES=2

# Stage 3 defaults for newly created user preferences; notifications are opt-in.
DEFAULT_TIMEZONE=Asia/Almaty
DAILY_DIGEST_TIME=09:00
# Stage 4.3 Daily Mission uses this timezone and NEWS_LOOKBACK_HOURS.
# It is opened manually; no separate mission scheduler or AI key is needed.

# Stage 4.1 Academy mastery threshold (percent of five question points).
MASTERY_THRESHOLD_PERCENT=80
REVIEW_FAILURE_INTERVAL_DAYS=1
REVIEW_SUCCESS_INTERVALS_DAYS=3,7,14,30
REVIEW_SESSION_SIZE=5

# Stage 4.4C resource recommendations use the packaged JSON catalog and
# the same NEWS_DB_PATH SQLite file. No API key or extra environment variable
# is needed. Preferred difficulty is saved per user from the Telegram UI.

# Stage 2.3.1 AI explanations: only the selected provider needs a key.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
AI_TIMEOUT_SECONDS=30
# Raise only if ai_explanation_result reports finish_reason=length.
AI_MAX_OUTPUT_TOKENS=1400
MAX_AI_CALLS_PER_DAY=10
AI_CONCURRENCY_LIMIT=2
